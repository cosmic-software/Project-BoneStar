<?xml version="1.0" encoding="UTF-8"?>
<veml xmlns="http://www.fivesqd.com/schemas/veml/3.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <metadata>
    <title>Project BoneStar</title>
    <capability>javascript</capability>
    <script>Scripts/orbit.js</script>
  </metadata>
  <environment>
    <!-- No background = the runtime's flat grey; space is black. -->
    <background>
      <color>#000000</color>
    </background>
    <entity xsi:type="light" tag="sun" id="9a6f662f-7b1e-43b7-8eff-52e101d45fb1">
      <transform xsi:type="scaletransform">
        <position x="0" y="75" z="0" />
        <rotation x="0.4177" y="-0.2506" z="0" w="0.8733" />
        <scale x="1" y="1" z="1" />
      </transform>
    </entity>
    <!-- Earth: earth.glb is a unit-radius sphere centred on its own origin (the built-in
         spheremesh pivots at its bottom and ignores color). 1 unit = 100 km, so
         scale = Earth radius 6378.1363 km = 63.781363 units, centred on the world origin. -->
    <entity xsi:type="mesh" tag="Earth" id="5d0c3e7a-8b1f-4c2e-9a6d-3f7b1e2c4a90">
      <transform xsi:type="scaletransform">
        <position x="0" y="0" z="0" />
        <rotation x="0" y="0" z="0" w="1" />
        <scale x="63.781363" y="63.781363" z="63.781363" />
      </transform>
      <mesh-name>../models/earth.glb</mesh-name>
      <mesh-resource>../models/earth.glb</mesh-resource>
    </entity>
    <!-- Atmosphere and night side, ONE model drawn in a fixed order:
         1. four lit, nearly transparent blue shells at 38-191 km (the glow; a soft rim at the
            limb where the line of sight crosses every shell twice);
         2. thirteen nested, unlit, flat-black hemispherical caps at 223-246 km, overlapping to
            50% opacity around local midnight and fading in 1 deg steps across the terminator.
         Scripts/orbit.js turns the model so the caps face away from GMAT's Sun (the shells are
         spheres, so turning them changes nothing). One model because this runtime sorts
         separate see-through models by camera distance, and their see-through materials write
         depth: as two models, the caps vanished whenever the camera moved so the glow drew
         last. Flat colours only: textured transparency does not render in this WebVerse build. -->
    <entity xsi:type="mesh" tag="Atmosphere" id="6f2a9c41-8d3e-4b57-a1c6-0e5d7b3f9a28">
      <transform xsi:type="scaletransform">
        <position x="0" y="0" z="0" />
        <rotation x="0" y="0" z="0" w="1" />
        <scale x="63.781363" y="63.781363" z="63.781363" />
      </transform>
      <mesh-name>../models/atmosphere.glb</mesh-name>
      <mesh-resource>../models/atmosphere.glb</mesh-resource>
    </entity>
    <!-- Spacecraft: the viewer creates one entity per spacecraft in data/fleet.json, with the
         model spacecraft.xlsx (sheet Models) gives it, probe.glb otherwise (Scripts/orbit.js
         CreateMissingCraft). -->
    <!-- The Assets panel and the spacecraft name labels are built in Scripts/orbit.js from the
         runtime's own text and buttons on world-space canvases. (VEML html entities were tried
         first: this runtime loads them with no parent canvas and gives them no size:
         "CanvasWebViewPrefab dimensions are invalid" in Player.log.) -->
  </environment>
</veml>
